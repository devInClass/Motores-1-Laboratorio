# Normaliza finales de línea para que el proyecto se abra igual en Windows, macOS y Linux.
* text=auto

# Escenas y prefabs: YAML de Unity
*.unity text eol=lf
*.prefab text eol=lf
*.asset text eol=lf
*.controller text eol=lf
*.anim text eol=lf
*.mat text eol=lf

# Binarios
*.png binary
*.jpg binary
*.psd binary
*.wav binary
*.mp3 binary
*.ogg binary
*.ttf binary
